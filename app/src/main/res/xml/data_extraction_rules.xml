<?xml version="1.0" encoding="utf-8"?>
<!--
    Резервна копія Android (Android 12+): хмара Google і перенесення на новий телефон.
    Копія лежить у Google-акаунті користувача, зашифрована блокуванням екрана; наш сервер
    її не бачить (FR-26, NFR-4). У debug-збірці копія вимкнена (allowBackup у build.gradle.kts).

    Лише будильники, місця й налаштування. Стан очікування (datastore/wait) не копіюємо:
    вчорашнє «зараз чекаю відбою» на новому телефоні лише заплутало б.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/alarms.preferences_pb" />
        <include domain="file" path="datastore/places.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/alarms.preferences_pb" />
        <include domain="file" path="datastore/places.preferences_pb" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
