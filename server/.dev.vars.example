# Скопіюй у .dev.vars. Файл у git не потрапляє.
#
# Локально працюємо на підробці: справжній токен на цю машину не кладемо взагалі,
# він живе лише в секретах Cloudflare. Підробка ще й зручніша — детермінована,
# не витрачає ліміти ukrainealarm і дозволяє оголосити відбій тоді, коли треба.
MOCK=1

# Службовий пароль локально не потрібен: wrangler dev на 127.0.0.1 / localhost пускає
# до /stats, /log і /mock без нього. Щоб перевірити пароль саме локально — задати будь-який:
# ADMIN_TOKEN=local-test

# Знадобиться, тільки якщо колись справді треба буде звірити розбір відповіді
# на живих даних локально. За замовчуванням — не заповнювати.
# UKRAINEALARM_TOKEN=
